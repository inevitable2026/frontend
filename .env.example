# Server-only credentials. Copy the variable names to .env.local and supply
# deployment-specific values. Never expose either variable with NEXT_PUBLIC_.
UPSTAGE_API_KEY=
LAW_GO_KR_OC=

# 현장 맥락 관리 — 문서 OCR · 벡터 검색
# 스키마는 tbm-check 레포가 소유한다. 여기서는 읽고 쓰기만 한다.
# Railway Postgres 는 TCP 프록시 주소를 써야 한다 — 내부 도메인은 Vercel 에서 닿지 않는다.
DATABASE_URL=

# 태스크 보드 저장소 — json(기본) · pg
# 비워 두면 data/board/seed-*.json 을 읽는 JSON 구현으로 돌고, pg 로 두면 Railway
# Postgres 의 board 스키마를 읽는다. pg 로 두려면 board 스키마가 먼저 있어야 한다:
#   node scripts/apply-board-migration.mjs   docs/migration-board.sql 을 적용한다
#   node scripts/seed-board.mjs              김포 고촌 시나리오를 적재한다
# 스키마가 없으면 /api/board/* 가 503 으로 무엇이 없는지 이름을 대고 멈춘다.
BOARD_STORE=

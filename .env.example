# Server-only credentials. Copy the variable names to .env.local and supply
# deployment-specific values. Never expose either variable with NEXT_PUBLIC_.
#
# UPSTAGE_API_KEY 는 두 곳에서 쓴다. 챗봇 사이드바(app/api/board/assistant)와
# 감지 생성 경로(lib/generate)다. 키가 없으면 감지는 조건을 기록하되 카드를 만들지 않고,
# 브리핑은 lib/board/briefing-fallback.ts 의 템플릿 문장으로 되돌아간다.
UPSTAGE_API_KEY=
LAW_GO_KR_OC=

# 생성 경로가 쓰는 모델. 비워 두면 solar-pro4 로 돈다.
UPSTAGE_MODEL=

# 현장 맥락 관리 — 문서 OCR · 벡터 검색
# 스키마는 tbm-check 레포가 소유한다. 여기서는 읽고 쓰기만 한다.
# Railway Postgres 는 TCP 프록시 주소를 써야 한다 — 내부 도메인은 Vercel 에서 닿지 않는다.
DATABASE_URL=

# 태스크 보드 저장소 — pg · json
# pg 로 두면 Railway Postgres 의 board 스키마를 읽는다. 먼저 스키마와 데이터가 있어야 한다:
#   node scripts/apply-board-migration.mjs   docs/migration-board.sql 을 적용한다
#   node scripts/seed-board.mjs              김포 고촌 시나리오를 적재한다
# 스키마가 없으면 /api/board/* 가 503 으로 무엇이 없는지 이름을 대고 멈춘다.
#
# 비워 두거나 json 으로 두면 data/board/seed-*.json 을 읽는 JSON 구현으로 도는데, 그
# 시드의 siteId 는 문자열 'site_gimpo_gochon_01' 이고 화면은 lib/board/site.ts 의 uuid 를
# 보내므로 보드가 404 '그런 현장이 없습니다.' 만 그린다. 그래서 기본값을 pg 로 적어 둔다.
BOARD_STORE=pg

# There is no authenticated console session yet, so production row review is
# fail-closed. A dev server bound to loopback requires this explicit opt-in and
# a server-side site allowlist. Do not expose an opted-in dev server to a LAN.
# Audit events honestly use the non-person actor "local-console".
RISK_ROW_REVIEW_LOCAL_ENABLED=false
# Chat history follows the same local-only access boundary until the console has
# request-bound authentication and per-site authorization in production.
CHAT_HISTORY_LOCAL_ENABLED=false
CONSOLE_SITE_IDS=

# 기상 관측 — 기상청 단기예보 조회서비스 (공공데이터포털)
#
# 공공데이터포털에서 「기상청_단기예보 조회서비스」를 신청하고 받은 일반 인증키를 넣는다.
# 인코딩 키가 아니라 **Decoding 키**를 그대로 적는다 — 코드가 URL 매개변수로 붙일 때
# 다시 인코딩하므로 인코딩 키를 넣으면 이중 인코딩이 되어 인증에 실패한다.
#
# 키가 없거나 호출이 실패하면 lib/connect/weather.ts 가 시나리오 시드값(주말 누적 41mm)으로
# 조용히 내려간다. 어느 경로였는지는 사실의 sourceDocId 와 value.구분 에 드러난다.
WEATHER_API_KEY=

# 현장의 단기예보 격자. 비워 두면 김포시 고촌읍 격자 (56, 127) 로 돈다.
# 부지 좌표가 확정되면 기상청 LCC 변환식으로 다시 구해 덮는다.
WEATHER_GRID_NX=
WEATHER_GRID_NY=

# 사면·법면 점검을 발동시키는 누적 강우 임계치(mm). 비워 두면 lib/detect/rainfall.ts 의
# 30mm 로 돈다. 그 값은 공식 근거가 없는 현장 설정값이라 발주처 기준이 있으면 여기서 덮는다.
WEATHER_RAIN_THRESHOLD_MM=

# 위험성평가 — SAFEGRID 백엔드
# 브라우저가 직접 부르지 않는다. 이 API 는 인증이 없어 주소를 아는 사람이
# GET /assessments 로 다른 현장 평가표까지 조회할 수 있다. app/api/risk/* 가 감싼다.
SAFEGRID_API_URL=

# Studio live ingestion is fail-closed. Keep false until the synthetic
# capability spike and tbm-check cleanup/sweeper migration have Gate C receipts.
STUDIO_LIVE_INGEST_ENABLED=false
# Schema-v3 Gate C JSON receipt. It contains either a production project-ID
# proof or localhost credential scope proof, requested-config pin evidence,
# manifest SHA, served-agent proof (never a config response echo), cleanup
# migration/sweeper health, and host budget.
STUDIO_LIVE_READINESS_RECEIPT_JSON=
# Production only: independently configured API project ID. It must equal the
# receipt's projectIdentity.projectId; localhost receipts are rejected in production.
STUDIO_EXPECTED_PROJECT_ID=
# Local development only: explicit opt-in for a localhost-development receipt.
# The receipt's credential-scope key fingerprint must match UPSTAGE_API_KEY.
STUDIO_LOCAL_CREDENTIAL_SCOPE_ENABLED=false
# Must match the migration version deployed by the schema-owning tbm-check repo.
STUDIO_REQUIRED_CLEANUP_MIGRATION=studio-cleanup-control-v1

# Direct v1 extraction is not a runtime fallback. Embeddings remain the only
# ancillary v1 document-ingest call outside the Studio-owned workflow.
